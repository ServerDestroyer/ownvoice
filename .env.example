# Copy to .env (gitignored) and fill in. CLI flags override any of these.

# Required for live API calls only — selftest/dry-run/blind never read it.
OPENROUTER_API_KEY=sk-or-...

# Run defaults for tools/meld.py
MELD_MODEL=google/gemini-3.1-pro-preview
MELD_TEMPERATURE=0.7
# Comma-separated arm ids from tools/meld_seeds.json; empty = all arms.
MELD_ARMS=
MELD_OUT=runs/b1
MELD_DRAFT=runs/b1/draft.md
MELD_ANCHOR=runs/b1/anchors/anchor1.md
