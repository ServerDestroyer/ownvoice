# Copy to .env (gitignored) and fill in. CLI flags override any of these.

# Required for live API calls only — selftest/dry-run/blind never read it.
OPENROUTER_API_KEY=sk-or-...

# Run defaults for tools/meld.py (the humanizing polisher)
MELD_MODEL=google/gemini-3.1-pro-preview
# Chris's finding: low temperature (~0.2); high was destructive on some models.
MELD_TEMPERATURE=0.2
# off = the model's lowest reasoning setting (Chris's finding: thinking off or lowest
# is best); default = let the model think at its default. Note: on OpenRouter
# gemini-3.1-pro-preview cannot go below "low" — thinking is mandatory there.
MELD_THINKING=off
# Comma-separated arm ids from tools/meld_seeds.json; empty = all arms.
# The first arm listed is what tock.py uses until tools/meld-v1.json is frozen at T3.
MELD_ARMS=
MELD_OUT=runs/b1
MELD_DRAFT=runs/b1/draft.md
MELD_ANCHOR=runs/b1/anchors/anchor1.md
