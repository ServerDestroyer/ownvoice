#!/usr/bin/env bash
# Run a tool under the venv on NixOS.
#
# The manylinux wheels (numpy, torch) dlopen libraries that are not on the default
# NixOS search path, so a bare `.venv/bin/python tools/guard.py --entailment minicheck`
# dies with "libstdc++.so.6: cannot open shared object file" — and, once past that,
# silently falls back to CPU because libcuda.so.1 is not found either.
#
# Both paths below belong to the running system generation, so they survive a
# garbage collect and a nixos-rebuild; do not substitute raw /nix/store paths.
#   /run/opengl-driver/lib .................. libcuda.so.1 (nvidia driver)
#   /run/current-system/sw/share/nix-ld/lib . libstdc++.so.6 and friends (nix-ld set)
#
# TRITON_LIBCUDA_PATH is the third: triton's libcuda_dirs() shells out to
# `/sbin/ldconfig -p`, which does not exist on NixOS, and the exception escapes as a
# bare FileNotFoundError from inside a T5 attention kernel. The knob short-circuits
# that lookup entirely (triton/backends/nvidia/driver.py).
#
# Everywhere else this degrades instead of failing. Off NixOS those /run paths do not
# exist, and .venv/ is gitignored, so on a fresh clone this used to exit 127 —
# "env: '.../.venv/bin/python': No such file or directory" — for the very command the
# docs prescribe. It now falls back to the system python, which runs the whole pipeline
# with the guard's lexicon layer alone; the optional layers report themselves
# not_checked rather than passing silently.
#
# Usage:  tools/py tools/guard.py --selftest --entailment minicheck
root="$(cd "$(dirname "$0")/.." && pwd)"
py="$root/.venv/bin/python"
[ -x "$py" ] || py="$(command -v python3)"

libs=""
for p in /run/opengl-driver/lib /run/current-system/sw/share/nix-ld/lib; do
    [ -d "$p" ] && libs="${libs:+$libs:}$p"
done
[ -n "$libs" ] && export LD_LIBRARY_PATH="${libs}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
[ -d /run/opengl-driver/lib ] && export TRITON_LIBCUDA_PATH="${TRITON_LIBCUDA_PATH:-/run/opengl-driver/lib}"

exec "$py" "$@"
